# Supabase Client Configuration (Public Browser Env)
# Leave blank to run in Demo Sandbox Mode (explicitly labeled in UI)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-Side AI Provider Keys (Configure ONLY in Vercel / Server Env - NEVER prefix with VITE_)
# HealthPoint Assistant automatically uses the first configured provider,
# or falls back to a clearly labeled deterministic database search assistant.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-70b-instruct
XAI_API_KEY=
XAI_MODEL=grok-2-latest
OPENAI_API_KEY=
GEMINI_API_KEY=
